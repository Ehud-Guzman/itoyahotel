# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Get your Project ID from https://sanity.io/manage
VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production

# ── Booking backend ───────────────────────────────────────────────────────────
# Local dev: http://localhost:4000
# Production: your Render service URL (e.g. https://hotel-itoya-api.onrender.com)
# Also used for the contact form — it posts to this same backend, which sends
# via Nodemailer/Gmail SMTP (see server/.env.example for those credentials).
VITE_API_URL=http://localhost:4000
