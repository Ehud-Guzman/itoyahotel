# Local development values. On Render, these come from the dashboard plus
# render.yaml at the repo root (which pins the build command, root directory
# and the few non-secret values); keep the two lists in step.
#
# ── Server ──────────────────────────────────────────────
PORT=4000

# ── Database (booking persistence) ───────────────────────
# Any standard Postgres connection string works — Neon, Supabase, Railway, etc.
# Without this set, bookings are stored in memory only and are LOST on restart/redeploy.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Frontend origin (for CORS) ───────────────────────────
FRONTEND_URL=https://hotelitoya.co.ke

# ── M-Pesa / Safaricom Daraja ────────────────────────────
# Register at https://developer.safaricom.co.ke
# Use sandbox values below for testing, swap for production when ready.
MPESA_ENV=sandbox                          # sandbox | production
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_SHORTCODE=174379                     # sandbox test shortcode
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://YOUR_RENDER_URL.onrender.com/api/mpesa/callback

# ── Email (Brevo transactional API) ──────────────────────
# Create a Brevo API key and verify the sender address in Brevo first.
BREVO_API_KEY=your-brevo-v3-api-key
EMAIL_USER=verified-sender@example.com
# Comma-separated addresses are supported; both receive enquiries and booking alerts.
HOTEL_EMAIL=hotel.itoya@ayotigroup.com,second@example.com

# ── Admin dashboard (/admin) ─────────────────────────────
# Shared password staff use to log in and view bookings.
ADMIN_PASSWORD=choose-a-strong-shared-password
# Random secret used to sign admin login sessions — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=replace-with-a-random-64-char-hex-string

# ── Receipt links in guest emails ────────────────────────
# The "Download your receipt" button in guest emails is a signed, expiring link,
# so only the holder of that email can use it. Signing falls back to
# ADMIN_JWT_SECRET when this is unset; set a separate one if you'd like to be
# able to revoke every emailed receipt link by rotating just this value.
# RECEIPT_SECRET=replace-with-a-random-64-char-hex-string
# Public base URL of this API, used to build those links. On Render,
# RENDER_EXTERNAL_URL is picked up automatically; set it explicitly on other
# hosts, or emails will link to localhost.
# PUBLIC_API_URL=https://your-api.onrender.com

# ── Guest ID document retention ──────────────────────────
# Photos of guests' IDs are only needed to register the guest and for a short
# time afterwards. Set this to delete them automatically that many days after
# CHECK-OUT (the booking record itself is kept; only the two ID images go).
# Deletion is permanent, so pick the period your record-keeping obligations
# require. When unset, nothing is deleted automatically.
# ID_RETENTION_DAYS=90
# Bookings that were never completed (payment never finished) keep their ID
# photos for this many days from creation. Default 7. Only applies when
# ID_RETENTION_DAYS is set.
# ID_ABANDONED_RETENTION_DAYS=7
