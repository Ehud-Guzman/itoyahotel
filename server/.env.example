# ── Server ──────────────────────────────────────────────
PORT=4000

# ── Database (booking persistence) ───────────────────────
# Any standard Postgres connection string works — Neon, Supabase, Railway, etc.
# Without this set, bookings are stored in memory only and are LOST on restart/redeploy.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Frontend origin (for CORS) ───────────────────────────
FRONTEND_URL=https://www.hotelitoya.co.ke

# ── M-Pesa / Safaricom Daraja ────────────────────────────
# Register at https://developer.safaricom.co.ke
# Use sandbox values below for testing, swap for production when ready.
MPESA_ENV=sandbox                          # sandbox | production
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_SHORTCODE=174379                     # sandbox test shortcode
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://YOUR_RENDER_URL.onrender.com/api/mpesa/callback

# ── Email (Gmail SMTP via Nodemailer) ────────────────────
# Use any Gmail account. Enable 2FA then generate an App Password:
# Google Account → Security → 2-Step Verification → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=yourgmailaccount@gmail.com
EMAIL_PASS=your-16-char-app-password
HOTEL_EMAIL=hotel.itoya@ayotigroup.com
